# ==============================================================================
# VRGC Forms — Git Ignore Configuration
# ==============================================================================

# ─── 1. Dependencies & Package Managers ───────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/

# ─── 2. Build Outputs, Next.js & Turbopack ─────────────────────────────────────
.next/
out/
build/
dist/
.turbo/

# ─── 3. Environment & Configuration Secrets ──────────────────────────────────
# All environment variable files must NEVER be committed to version control
.env*
!.env.example
!.env.local.example
*.env
*.env.*

# ─── 4. Cloud, Firebase & Service Account Credentials ─────────────────────────
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json
google-services.json
credentials.json
client_secret*.json
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.p8
*.jks
*.keystore
id_rsa*
id_ed25519*

# ─── 5. Cache & Build Metadata ────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
.eslintcache
.cache/
*.lcov

# ─── 6. Testing, Coverage & Reports ───────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ─── 7. Logs & Diagnostics ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ─── 8. Operating System Specific ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
[Tt]humbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
Icon?

# ─── 9. IDEs, Editors & Workspaces ────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*~
*.sublime-workspace
*.sublime-project

# ─── 10. Cloud & Hosting CLI Artifacts ────────────────────────────────────────
.vercel
.firebase/
.firebaserc.local

# ─── 11. Private / Sensitive User & Club Data ─────────────────────────────────
public/members.csv
public/admins.csv
*.csv
!public/*.example.csv
*.xlsx
*.xls

# ─── 12. Temporary, Scratch & Archive Files ───────────────────────────────────
*.tmp
*.temp
.tmp/
.temp/
scratch/
*.bak
*.backup
*.orig
*.old
*.patch
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
