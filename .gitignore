!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & system
.DS_Store
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
*.pem
*.key
*.p12
*.pfx

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.local.example

# Firebase & Google Cloud credentials / service accounts
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json
google-services.json

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo
*~

# vercel
.vercel

