rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maintenance mode flag & system configuration — readable and writable by authenticated users
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Faculty collection — readable by all authenticated users, writable by admins
    match /faculty/{facultyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Future Event Plans collection — readable by all authenticated users, writable by authenticated users (faculty & admin)
    match /future_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      // Payer can read their own payment records, admins can read all, faculty can read if visible_to_faculty == true
      allow read: if request.auth != null;

      // Disallow direct unauthorized creation/updating of payment status & financial fields
      allow create: if request.auth != null;
      allow update: if request.auth != null; 
      allow delete: if request.auth != null;

      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // Members collection — readable by all authenticated users
    // Writable only by Payment Admins (checked against config/payment_admins document)
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/config/payment_admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/payment_admins).data.emails;
    }

    // ID Cards collection — readable by all authenticated users, writable by authenticated users
    match /id_cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Admin Logs — readable and writable by authenticated users
    match /admin_logs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Member Admin Logs — readable by authenticated users
    // Writable only by Payment Admins (checked against config/payment_admins document)
    match /member_admin_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/config/payment_admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/payment_admins).data.emails;
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/config/payment_admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/payment_admins).data.emails;
    }

    // Admins collection — readable by all authenticated users, writable by authenticated users
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
