rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Maintenance mode flag — readable by all authenticated users, writable only by payment admin
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vrgc@vitbhopal.ac.in' ||
        request.auth.token.email == 'haardik.24bcg10051@vitbhopal.ac.in'
      );
    }

    // Faculty collection — readable by all authenticated users, writable by admins
    match /faculty/{facultyId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Future Event Plans collection — readable by all authenticated users, writable by authenticated users (faculty & admin)
    match /future_events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      // Payer can read their own payment records, admins can read all, faculty can read if visible_to_faculty == true
      allow read: if request.auth != null;

      // Disallow direct unauthorized creation/updating of payment status & financial fields
      allow create: if request.auth != null;
      allow update: if request.auth != null; 
      allow delete: if request.auth != null;

      match /attempts/{attemptId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
  }
}
