rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Reusable Authorization Functions
    // =========================================================================

    // Validates that the client request has an authenticated session
    function isAuthenticated() {
      return request.auth != null;
    }

    // Extracts normalized, lowercase email from authentication token
    function userEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Checks whether the caller is a Super Admin.
    // Derived strictly from the /super_admins collection, which is non-writable by clients.
    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/super_admins/$(userEmail()));
    }

    // Checks whether the caller is an Admin.
    // Super Admins automatically satisfy Admin privilege.
    // Admins must exist in /admins (which only Super Admins can manage).
    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/admins/$(userEmail()))
      );
    }

    // Checks whether the user is explicitly flagged as blocked in the database.
    // Super Admins are immune from blocking restrictions.
    function isBlockedUser() {
      return isAuthenticated() && !isSuperAdmin() && (
        (exists(/databases/$(database)/documents/members/$(userEmail())) &&
         get(/databases/$(database)/documents/members/$(userEmail())).data.get('isBlocked', false) == true) ||
        (exists(/databases/$(database)/documents/id_cards/$(userEmail())) &&
         get(/databases/$(database)/documents/id_cards/$(userEmail())).data.get('isBlocked', false) == true) ||
        exists(/databases/$(database)/documents/blocked_users/$(userEmail()))
      );
    }

    // Ensures that caller is authenticated AND not blocked
    function isActiveMember() {
      return isAuthenticated() && !isBlockedUser();
    }

    // =========================================================================
    // 1. System Configuration & Metadata
    // =========================================================================
    // Publicly readable so unauthenticated visitors receive real-time maintenance
    // status and permissions matrix on the home page. Writable strictly by Super Admins.
    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Administrative & Role Registries
    // =========================================================================
    // Super Admins: Normal authenticated users can ONLY fetch their own record.
    // Listing the collection is restricted to Super Admins to protect hidden identity.
    // Client writes are completely disabled (write: false).
    match /super_admins/{superAdminId} {
      allow get: if isAuthenticated() && (superAdminId == userEmail() || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // Admins: Readable by authenticated users (needed for Referrals roster & Admin lists).
    // Writable ONLY by Super Admins.
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Roles: Users can only read their own role document.
    // Listing all roles is restricted to Super Admins.
    // Writable ONLY by Super Admins.
    match /roles/{roleId} {
      allow get: if isAuthenticated() && (roleId == userEmail() || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Roles Registry: Unused legacy collection, writable ONLY by Super Admins.
    match /roles_registry/{roleId} {
      allow read: if false;
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 3. Payments & Financial Records
    // =========================================================================
    // Direct client mutation is completely disabled. All payment creation,
    // verification, updates, and webhook callbacks run via Firebase Admin SDK.
    match /payments/{paymentId} {
      allow read: if isActiveMember();
      allow write: if false;

      match /attempts/{attemptId} {
        allow read: if isActiveMember();
        allow write: if false;
      }
    }

    // =========================================================================
    // 4. Members & ID Cards
    // =========================================================================
    // Member directory: Authenticated users can browse roster; writable only by Admins.
    match /members/{memberId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // ID Cards: Authenticated read (used by IDCard and Referrals components).
    // Public ID verification runs server-side via Admin SDK.
    // Authenticated users may create/update only their own dossier. Deletions require Admin.
    match /id_cards/{cardId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && (
        isAdmin() || (
          cardId == userEmail() &&
          (!('email' in request.resource.data) || request.resource.data.email.lower() == userEmail())
        )
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. Faculty & Events
    // =========================================================================
    match /faculty/{facultyId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    match /blocked_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /future_events/{eventId} {
      allow read: if isActiveMember();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. Candidate Referrals
    // =========================================================================
    // Authenticated users can read referrals and submit candidate referrals under their own identity.
    // Status updates (approvals/rejections) and record deletions are restricted to Admins.
    match /referrals/{referralId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && (request.resource.data.referrerEmail == userEmail() || isAdmin());
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. Administrative Audit & Activity Logs
    // =========================================================================
    // Direct client mutation is completely disabled. All audit log creation,
    // auto-pruning, and deletions run server-side via Firebase Admin SDK.
    // Reading logs is restricted to authorized Admins for UI live streams.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 8. Idea Curator Hub
    // =========================================================================
    match /club_ideas/{ideaId} {
      allow read, create, update: if isActiveMember();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 9. Idea Notifications (Notification Hub)
    // =========================================================================
    match /idea_notifications/{notifId} {
      allow read, create, update, delete: if isActiveMember();
    }

    // =========================================================================
    // 10. Audit Sessions
    // =========================================================================
    match /audit_sessions/{sessionId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 11. Support Desk & Contact Tickets
    // =========================================================================
    match /support_tickets/{ticketId} {
      // Anyone can submit a ticket from the Contact Us page
      allow create: if true;
      // Single ticket lookup by ID allows anyone with the ticket ID to track their ticket
      allow get: if true;
      // Listing all tickets requires Admin privilege
      allow list: if isAdmin();
      // Admins can resolve, update, or delete tickets
      allow update, delete: if isAdmin();
    }

    function isCaster() {
      return isAuthenticated() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/live_casters/$(userEmail()))
      );
    }

    // =========================================================================
    // 12. Live Broadcast & Real-Time Match Engine
    // =========================================================================
    // Public read access enables low-latency real-time synchronization on vrgc.live.
    // Mutation is restricted to Casters, Caster Managers, and Super Admins.
    match /live_config/{docId} {
      allow read: if true;
      allow write: if isCaster();
    }

    match /live_matches/{docId} {
      allow read: if true;
      allow write: if isCaster();
    }

    // Live Casters Registry: Publicly readable for credentials, writable only via Server API
    match /live_casters/{casterId} {
      allow read: if true;
      allow write: if false;
    }

    // Real-time spectator chat: public read and write access, moderation restricted to administrators.
    match /live_chat/{chatId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isCaster();
    }

    // =========================================================================
    // 13. Explicit Catch-All Default Deny
    // =========================================================================
    // Unmatched documents across all databases/collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

